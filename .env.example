MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mockmitra
# optional; defaults to mockmitra even if the URI has no /database path
# MONGODB_DB=mockmitra
JWT_SECRET=change-me-to-a-long-random-string
# used by scripts/seed-admin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Claude API: AI coach reports, per-paper insights and coach Q&A (also used by the offline pdf2json tool).
# Without it the AI buttons are hidden and only offline reports are shown.
ANTHROPIC_API_KEY=
# optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# AI_DAILY_REPORTS=6     # coach/paper reports per student per 24 h
# AI_DAILY_MESSAGES=60   # coach Q&A messages per student per 24 h
